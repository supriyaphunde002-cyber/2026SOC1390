#include <iostream>
using namespace std;


class Person {
public:
    string name;
    int age;

    void getPerson() 
    {
        cout << "Enter name: ";
        cin >> name;
        cout << "Enter age: ";
        cin >> age;
    }
};

class Student : public Person {
public:
    int rollNo;

    void getStudent() {
        cout << "Enter roll number: ";
        cin >> rollNo;
    }

    void displayStudent() {
        cout << "Student Details" << endl;
        cout << "Name: " << name << endl;
        cout << "Age: " << age << endl;
        cout << "Roll Number: " << rollNo << endl;
    }
};


class Vehicle {
public:
    string brand;

    void getVehicle() {
        cout << "Enter vehicle brand: ";
        cin >> brand;
    }
};

class Car : public Vehicle {
public:
    int seats;

    void getCar() {
        cout << "Enter number of seats: ";
        cin >> seats;
    }
};

class ElectricCar : public Car {
public:
    int battery;

    void getElectricCar() {
        cout << "Enter battery capacity: ";
        cin >> battery;
    }

    void displayElectricCar() {
        cout << "Electric Car Details" << endl;
        cout << "Brand: " << brand << endl;
        cout << "Seats: " << seats << endl;
        cout << "Battery Capacity: " << battery << " kWh" << endl;
    }
};

int main() {
    cout << "--- Single Inheritance ---" << endl;

    Student s;
    s.getPerson();
    s.getStudent();
    s.displayStudent();

    cout << "--- Multilevel Inheritance ---" << endl;

    ElectricCar e;
    e.getVehicle();
    e.getCar();
    e.getElectricCar();
    e.displayElectricCar();

    return 0;
}
