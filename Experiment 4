
#include <iostream>
#include <string>
using namespace std;

class Employee {
private:
    int empId;
    string name;
    float salary;
    float bonus;

public:
    Employee() {
        empId = 0;
        name = "Unknown";
        salary = 0;
        bonus = 0;
    }

    Employee(int id, string n, float s, float b) {
        empId = id;
        name = n;
        salary = s;
        bonus = b;
    }

    void display() {
        float totalSalary = salary + bonus;

        cout << "Employee ID: "<<empId<<endl;
        cout << "Employee Name: "<<name<<endl;
        cout << "Basic Salary: "<<salary<<endl;
        cout << "Bonus: "<<bonus<<endl;
        cout << "Total Salary: "<<totalSalary<<endl;
    }
};

int main() 
{
    Employee e1;
    cout << "Default Constructor Details:";
    e1.display();

    Employee e2(101, "Rahul", 25000, 5000);
    cout << "Parameterized Constructor Details:"<<endl;
    e2.display();

    return 0;
}
